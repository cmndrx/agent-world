{
  "name": "agent-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Sims-style low-poly world that visualizes AI agents working on your machine.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo": "node scripts/dev.mjs --demo",
    "bridge": "node bridge/server.mjs",
    "fake": "node adapters/fake-agent.mjs",
    "build": "vite build",
    "start": "vite build && node scripts/dev.mjs --prod",
    "test": "node --test test/",
    "hooks:claude": "node adapters/claude-code/install.mjs",
    "codex": "node adapters/codex/tail.mjs",
    "world": "node skills/agent-world/scripts/platform.mjs",
    "app": "vite build && electron .",
    "app:demo": "vite build && electron . --demo",
    "app:build": "vite build && electron-builder --mac --dir"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "lucide-static": "^1.52.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "26.8.0",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "dev.agentworld.app",
    "productName": "Agent World",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "electron/build"
    },
    "files": [
      "package.json",
      "electron/main.cjs",
      "dist/**",
      "bridge/**",
      "shared/**",
      "adapters/**",
      "!**/node_modules/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dir"
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "electron/build/icon.icns",
      "identity": "-",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Talk to your agents in Agent World using Codex voice."
      }
    },
    "npmRebuild": false
  }
}
